<?xml version="1.0" encoding="UTF-8"?>

<?import com.siliconsquad.siliconsquadmoviebooking.components.MovieBackgroundPane?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<?import eu.hansolo.tilesfx.Tile?>
<StackPane maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="400.0"
           prefWidth="600.0"
           styleClass="main-background"
           stylesheets="@background.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.BookingController">
    <children>
        <!-- White animated lines across the full blue page. -->
        <MovieBackgroundPane />
        <!-- Main page controls displayed above the animation. -->
        <BorderPane styleClass="pane-padding" style="-fx-background-color: transparent;">
                <top>
                </top>
                <left>
                    <VBox
                          style="-fx-background-color: transparent;"
                          alignment="TOP_CENTER"
                          prefHeight="175.0"
                          prefWidth="200.0"
                          spacing="20.0"
                          BorderPane.alignment="CENTER">
                    </VBox>
                </left>
                <center>
                    <VBox style="-fx-background-color: transparent;"
                          alignment="CENTER"
                          prefHeight="800.0"
                          prefWidth="200.0"
                          BorderPane.alignment="CENTER">
                        <HBox alignment="CENTER" prefWidth="200.0" style="-fx-background-color: black;">
                            <padding>
                                <Insets top="40"></Insets>
                            </padding>
                            <Label fx:id="movieLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px"></Label>
                        </HBox>
                        <HBox alignment="CENTER" prefWidth="200.0" style="-fx-background-color: black;">
                            <Label fx:id="theaterLabel" styleClass="theater-info"></Label>
                            <Label fx:id="dateLabel" styleClass="theater-info"></Label>
                            <Label fx:id="timeLabel" styleClass="theater-info"></Label>
                        </HBox>
                        <HBox style="-fx-background-color: black;"
                              alignment="CENTER"
                              prefWidth="200.0">
                            <padding>
                                <Insets top="50.0"></Insets>
                            </padding>
                            <Label style="-fx-text-fill: #F2F2F2;">SCREEN</Label>
                        </HBox>
                        <HBox alignment="TOP_CENTER" style="-fx-background-color: black;">
                            <Rectangle height="10.0" width="400" style="-fx-fill: gray;" ></Rectangle>
                        </HBox>
                        <HBox style="-fx-background-color: black;"
                              alignment="TOP_CENTER"
                              prefHeight="100.0"
                              prefWidth="50.0">
                            <padding>
                                <Insets top="50.0"></Insets>
                            </padding>
                            <GridPane fx:id="frontSectionGridPane" minWidth="500.0" maxWidth="1200.0" hgap="10.0" vgap="10.0" alignment="CENTER">
                                <children></children>
                            </GridPane>
                        </HBox>
                        <HBox style="-fx-background-color: black;"
                              alignment="TOP_CENTER"
                              prefHeight="300.0">
                            <GridPane fx:id="backSectionGridPane" minWidth="500.0" maxWidth="1200.0" hgap="10.0" vgap="10.0" alignment="CENTER">
                                <padding>
                                    <Insets top="50.0"></Insets>
                                </padding>
                                <children></children>
                            </GridPane>
                        </HBox>
                        <HBox style="-fx-background-color: black;" alignment="BASELINE_CENTER">
                            <padding>
                                <Insets top="40.0" bottom="50.0"></Insets>
                            </padding>
                            <Label style="-fx-text-fill: #F2F2F2;">BACK OF THEATER</Label>
                        </HBox>
                    </VBox>
                </center>
                <right>
                    <VBox alignment="CENTER"
                          style="-fx-background-color: white;"
                          maxHeight="757.5"
                          prefWidth="300.0"
                          spacing="20.0"
                          BorderPane.alignment="CENTER">
                        <HBox alignment="CENTER">
                            <padding>
                                <Insets left="20" bottom="20"></Insets>
                            </padding>
                            <Label styleClass="checkout-label">Checkout Cart</Label>
                        </HBox>
                        <HBox spacing="100.0">
                            <padding>
                              <Insets left="20" bottom="20"></Insets>
                            </padding>
                            <Label styleClass="seat-number-label" wrapText="false" minWidth="100.0">Seat Number(s)</Label>
                            <Label styleClass="seat-number-value" fx:id="seatLabel" wrapText="true"></Label>
                        </HBox>
                        <HBox spacing="170.0">
                            <padding>
                                <Insets left="20"></Insets>
                            </padding>
                            <Label styleClass="price-label">Price</Label>
                            <Label styleClass="price-label-value" fx:id="priceLabel"></Label>
                        </HBox>
                        <HBox alignment="CENTER">
                            <padding>
                                <Insets left="20"></Insets>
                            </padding>
                            <Button>Review and pay</Button>
                        </HBox>
                        <HBox alignment="CENTER">
                            <padding>
                                <Insets left="20"></Insets>
                            </padding>
                            <Button onAction="#backToMain" fx:id="backButton" text="Back"></Button>
                        </HBox>
                    </VBox>
                </right>
        </BorderPane>
    </children>
</StackPane>
