<?xml version="1.0" encoding="UTF-8"?>

<?import com.siliconsquad.siliconsquadmoviebooking.components.MovieBackgroundPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane
        prefWidth="1080.0"
        prefHeight="800.0"
        styleClass="booking-root"
        stylesheets="@booking.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.BookingController">

    <MovieBackgroundPane/>

    <HBox
            alignment="CENTER"
            spacing="25.0">

        <padding>
            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
        </padding>

        <!-- Theater section -->
        <VBox
                alignment="TOP_CENTER"
                spacing="12.0"
                styleClass="theater-card"
                HBox.hgrow="ALWAYS">

            <Label
                    fx:id="movieLabel"
                    text="Movie"
                    styleClass="movie-title"/>

            <Label
                    fx:id="theaterLabel"
                    text="ROOM - TIME - DATE"
                    styleClass="showtime-text"/>

            <Region prefHeight="8.0"/>

            <Label
                    text="S C R E E N"
                    styleClass="screen-title"/>

            <StackPane
                    prefHeight="25.0"
                    maxWidth="720.0"
                    styleClass="screen-holder">

                <Region styleClass="screen-glow"/>
            </StackPane>

            <Region prefHeight="8.0"/>

            <GridPane
                    fx:id="frontSectionGridPane"
                    alignment="CENTER"
                    hgap="6.0"
                    vgap="6.0"/>

            <Region prefHeight="20.0"/>

            <GridPane
                    fx:id="backSectionGridPane"
                    alignment="CENTER"
                    hgap="6.0"
                    vgap="6.0"/>

            <Region prefHeight="10.0"/>

            <!-- Seat legend -->
            <HBox
                    alignment="CENTER"
                    spacing="75.0"
                    styleClass="seat-legend">

                <VBox
                        alignment="CENTER"
                        spacing="9.0"
                        styleClass="legend-item">

                    <Region prefWidth="34.0" prefHeight="31.0" minWidth="34.0" minHeight="31.0" maxWidth="34.0" maxHeight="31.0" style="-fx-background-color: linear-gradient(to bottom, white, #D7DEE7); -fx-background-radius: 7; -fx-border-color: white; -fx-border-radius: 7; -fx-border-width: 1;"/>
                    <Label text="Available" styleClass="legend-label"/>
                </VBox>

                <VBox
                        alignment="CENTER"
                        spacing="9.0"
                        styleClass="legend-item">

                    <Region prefWidth="34.0" prefHeight="31.0" minWidth="34.0" minHeight="31.0" maxWidth="34.0" maxHeight="31.0" style="-fx-background-color: linear-gradient(to bottom, #35AEFF, #006DEB); -fx-background-radius: 7; -fx-border-color: #7BD4FF; -fx-border-radius: 7; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(20,148,255,0.9), 12, 0.4, 0, 2);"/>
                    <Label text="Selected" styleClass="legend-label"/>
                </VBox>

                <VBox
                        alignment="CENTER"
                        spacing="9.0"
                        styleClass="legend-item">

                    <Region prefWidth="34.0" prefHeight="31.0" minWidth="34.0" minHeight="31.0" maxWidth="34.0" maxHeight="31.0" style="-fx-background-color: linear-gradient(to bottom, #FF4C59, #D80F24); -fx-background-radius: 7; -fx-border-color: #FF929A; -fx-border-radius: 7; -fx-border-width: 2;"/>
                    <Label text="Unavailable" styleClass="legend-label"/>
                </VBox>

            </HBox>

            <Label
                    text="BACK OF THEATER"
                    styleClass="back-theater-label"/>

        </VBox>

        <!-- Checkout section -->
        <VBox
                alignment="TOP_CENTER"
                spacing="18.0"
                prefWidth="320.0"
                maxWidth="320.0"
                styleClass="checkout-card">

            <padding>
                <Insets top="30.0" right="25.0" bottom="28.0" left="25.0"/>
            </padding>

            <ImageView
                    fitWidth="105.0"
                    fitHeight="105.0"
                    preserveRatio="true"
                    smooth="true"
                    styleClass="checkout-logo">

                <image>
                    <Image url="@icon.png"/>
                </image>
            </ImageView>

            <Label
                    text="Checkout Cart"
                    styleClass="checkout-title"/>

            <Region
                    prefHeight="1.0"
                    maxWidth="Infinity"
                    styleClass="checkout-divider"/>

            <!-- Selected seats -->
            <VBox
                    alignment="TOP_LEFT"
                    spacing="8.0"
                    maxWidth="Infinity">

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="8.0">

                    <Label
                            text="■"
                            styleClass="section-icon"/>

                    <Label
                            text="Selected Seats"
                            styleClass="summary-heading"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Label
                            fx:id="seatCountLabel"
                            text="0 seats"
                            styleClass="seat-count"/>
                </HBox>

                <StackPane
                        minHeight="72.0"
                        maxWidth="Infinity"
                        styleClass="selected-seats-box">

                    <Label
                            fx:id="seatLabel"
                            text="No seats selected"
                            wrapText="true"
                            maxWidth="245.0"
                            styleClass="selected-seats-value"/>
                </StackPane>

            </VBox>

            <!-- Total price -->
            <VBox
                    alignment="TOP_LEFT"
                    spacing="8.0"
                    maxWidth="Infinity">

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="8.0">

                    <Label
                            text="USD"
                            styleClass="section-icon"/>

                    <Label
                            text="Total Price"
                            styleClass="summary-heading"/>
                </HBox>

                <StackPane
                        minHeight="72.0"
                        maxWidth="Infinity"
                        styleClass="total-price-box">

                    <Label
                            fx:id="priceLabel"
                            text="0.00"
                            styleClass="total-price-value"/>
                </StackPane>

            </VBox>

            <Region
                    prefHeight="10.0"
                    VBox.vgrow="ALWAYS"/>

            <Button
                    fx:id="checkoutButton"
                    text="Review and Pay"
                    onAction="#reviewAndPay"
                    maxWidth="Infinity"
                    styleClass="review-button"/>

            <Button
                    fx:id="backButton"
                    text="Back"
                    onAction="#backToMain"
                    maxWidth="Infinity"
                    styleClass="booking-back-button"/>

            <Label
                    text="Secure booking"
                    styleClass="secure-label"/>

        </VBox>

    </HBox>

</StackPane>