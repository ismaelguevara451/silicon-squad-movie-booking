<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="540.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />

    <Button fx:id="loginbutton" onAction="#onHelloButtonClick" prefHeight="60" prefWidth="250" text="Login" />

    <Button fx:id="registerbutton" onAction="#registerButtonClick" prefHeight="60" prefWidth="250" text="Register" />

    <Button fx:id="exitbutton" onAction="#exitButtonClick" prefHeight="60" prefWidth="250" text="Exit" />
</VBox>
