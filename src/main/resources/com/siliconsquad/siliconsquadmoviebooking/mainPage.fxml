<?xml version="1.0" encoding="UTF-8"?>

<?import com.siliconsquad.siliconsquadmoviebooking.components.MovieBackgroundPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1080.0"
        prefHeight="800.0"
        styleClass="main-background"
        stylesheets="@background.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.MainController">

    <children>

        <MovieBackgroundPane/>

        <BorderPane styleClass="professional-main-overlay">

            <top>

                <VBox spacing="12.0">

                    <padding>
                        <Insets
                                top="14.0"
                                right="24.0"
                                bottom="8.0"
                                left="24.0"/>
                    </padding>

                    <children>

                        <!-- Top navigation -->
                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="18.0"
                                styleClass="main-navigation-card">

                            <padding>
                                <Insets
                                        top="10.0"
                                        right="16.0"
                                        bottom="10.0"
                                        left="16.0"/>
                            </padding>

                            <children>

                                <ImageView
                                        fitWidth="52.0"
                                        fitHeight="52.0"
                                        preserveRatio="true">

                                    <image>
                                        <Image url="@icon.png"/>
                                    </image>
                                </ImageView>

                                <VBox spacing="0.0">

                                    <children>

                                        <Label
                                                text="SILICON SQUAD"
                                                styleClass="brand-title"/>

                                        <Label
                                                text="MOVIE BOOKING"
                                                styleClass="brand-subtitle"/>

                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <TextField
                                        fx:id="searchField"
                                        promptText="Search for a movie..."
                                        prefWidth="370.0"
                                        styleClass="professional-search-field"/>

                                <Button
                                        text="Search"
                                        onAction="#searchMovies"
                                        styleClass="professional-search-button"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button
                                        fx:id="logoutButton"
                                        text="Log out"
                                        onAction="#logoutUser"
                                        styleClass="professional-logout-button"/>

                            </children>
                        </HBox>

                        <!-- Now showing heading -->
                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="3.0"
                                styleClass="now-showing-header">

                            <children>

                                <Label
                                        text="▰  NOW SHOWING"
                                        styleClass="now-showing-title"/>

                                <Label
                                        text="Select a movie to view available showtimes"
                                        styleClass="now-showing-subtitle"/>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </top>

            <center>

                <VBox spacing="14.0">

                    <padding>
                        <Insets
                                top="0.0"
                                right="24.0"
                                bottom="20.0"
                                left="24.0"/>
                    </padding>

                    <children>

                        <!-- Movie cards -->
                        <ScrollPane
                                fitToWidth="true"
                                prefViewportHeight="500.0"
                                styleClass="movie-scroll-pane"
                                VBox.vgrow="ALWAYS">

                            <content>

                                <TilePane
                                        fx:id="movieGrid"
                                        alignment="TOP_CENTER"
                                        hgap="14.0"
                                        vgap="14.0"
                                        prefColumns="6"
                                        styleClass="movie-grid">

                                    <padding>
                                        <Insets
                                                top="10.0"
                                                right="8.0"
                                                bottom="10.0"
                                                left="8.0"/>
                                    </padding>

                                </TilePane>

                            </content>
                        </ScrollPane>

                        <!-- Professional showtime panel -->
                        <VBox
                                fx:id="showtimesPanel"
                                spacing="12.0"
                                minHeight="230.0"
                                maxWidth="Infinity"
                                styleClass="professional-showtimes-panel">

                            <padding>
                                <Insets
                                        top="16.0"
                                        right="22.0"
                                        bottom="14.0"
                                        left="22.0"/>
                            </padding>

                        </VBox>

                    </children>
                </VBox>

            </center>

        </BorderPane>

    </children>
</StackPane>