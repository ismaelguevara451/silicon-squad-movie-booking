<?xml version="1.0" encoding="UTF-8"?>

<?import com.siliconsquad.siliconsquadmoviebooking.components.AnimatedLinesPane?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="400.0"
           prefWidth="600.0"
           styleClass="main-background"
           stylesheets="@background.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.LoginController">

    <children>

        <!--
        This gradient creates the white login area while softly blending
        into the blue section instead of creating a hard divider.
        -->
        <Pane maxWidth="390.0"
              prefWidth="390.0"
              StackPane.alignment="CENTER_RIGHT"
              style="-fx-background-color: linear-gradient(to right,
                     rgba(255,255,255,0.00) 0%,
                     rgba(255,255,255,0.55) 9%,
                     rgba(255,255,255,0.92) 20%,
                     white 32%,
                     white 100%);" />

        <!-- One animation canvas covering the entire screen -->
        <AnimatedLinesPane />

        <!-- Login page content -->
        <BorderPane style="-fx-background-color: transparent;">

            <left>
                <StackPane prefHeight="400.0"
                           prefWidth="247.0"
                           BorderPane.alignment="CENTER">

                    <children>
                        <ImageView fitHeight="230.0"
                                   fitWidth="230.0"
                                   preserveRatio="true"
                                   smooth="true">

                            <image>
                                <Image url="@icon.png" />
                            </image>
                        </ImageView>
                    </children>
                </StackPane>
            </left>

            <right>
                <VBox alignment="CENTER"
                      maxWidth="354.0"
                      prefHeight="400.0"
                      prefWidth="354.0"
                      spacing="18.0"
                      style="-fx-background-color: transparent;"
                      BorderPane.alignment="CENTER">

                    <padding>
                        <Insets bottom="35.0"
                                left="45.0"
                                right="30.0"
                                top="35.0" />
                    </padding>

                    <children>
                        <Label text="LOGIN"
                               textFill="#1E90FF">

                            <font>
                                <Font name="System Bold"
                                      size="30.0" />
                            </font>
                        </Label>

                        <Label text="Sign in to continue"
                               textFill="#777777">

                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>

                        <VBox maxWidth="260.0"
                              spacing="7.0">

                            <children>
                                <Label text="Username"
                                       textFill="#333333">

                                    <font>
                                        <Font name="System Bold"
                                              size="13.0" />
                                    </font>
                                </Label>

                                <TextField fx:id="usernameField"
                                           id="login-username"
                                           prefHeight="38.0"
                                           promptText="Enter your username"
                                           style="-fx-background-color: rgba(255,255,255,0.96);
                                                  -fx-background-radius: 10;
                                                  -fx-border-radius: 10;
                                                  -fx-border-color: #CFCFCF;
                                                  -fx-padding: 0 12 0 12;" />
                            </children>
                        </VBox>

                        <VBox maxWidth="260.0"
                              spacing="7.0">

                            <children>
                                <Label text="Password"
                                       textFill="#333333">

                                    <font>
                                        <Font name="System Bold"
                                              size="13.0" />
                                    </font>
                                </Label>

                                <PasswordField fx:id="passwordField"
                                               id="login-password"
                                               prefHeight="38.0"
                                               promptText="Enter your password"
                                               style="-fx-background-color: rgba(255,255,255,0.96);
                                                      -fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #CFCFCF;
                                                      -fx-padding: 0 12 0 12;" />
                            </children>
                        </VBox>

                        <Button fx:id="loginButton"
                                maxWidth="260.0"
                                mnemonicParsing="false"
                                onAction="#moveToHome"
                                prefHeight="38.0"
                                text="Login"
                                textFill="WHITE" />

                        <HBox alignment="CENTER"
                              spacing="10.0">

                            <children>
                                <Button fx:id="registerButton"
                                        mnemonicParsing="false"
                                        onAction="#moveToRegister"
                                        text="Register"
                                        textFill="WHITE" />

                                <Button fx:id="forgotPasswordButton" onAction="#moveToForgotPassword"
                                        mnemonicParsing="false"
                                        text="Forgot Password"
                                        textFill="WHITE" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </right>

        </BorderPane>
    </children>
</StackPane>

