<?xml version="1.0" encoding="UTF-8"?>

<?import com.siliconsquad.siliconsquadmoviebooking.components.AnimatedLinesPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="400.0"
           prefWidth="600.0"
           styleClass="main-background"
           stylesheets="@background.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ForgotPasswordController">

    <children>

        <Pane maxWidth="430.0"
              prefWidth="430.0"
              StackPane.alignment="CENTER_RIGHT"
              style="-fx-background-color: linear-gradient(to right,
                     rgba(255,255,255,0.00) 0%,
                     rgba(255,255,255,0.55) 9%,
                     rgba(255,255,255,0.92) 20%,
                     white 32%,
                     white 100%);" />

        <AnimatedLinesPane />

        <BorderPane style="-fx-background-color: transparent;">

            <left>
                <VBox alignment="CENTER"
                      prefHeight="400.0"
                      prefWidth="247.0"
                      spacing="18.0"
                      BorderPane.alignment="CENTER">

                    <children>
                        <ImageView fitHeight="215.0"
                                   fitWidth="215.0"
                                   preserveRatio="true"
                                   smooth="true">
                            <image>
                                <Image url="@icon.png" />
                            </image>
                        </ImageView>

                        <Label alignment="CENTER"
                               text="Remembered your password?"
                               textAlignment="CENTER"
                               textFill="WHITE">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>

                        <Button fx:id="backButton"
                                mnemonicParsing="false"
                                onAction="#backToLogin"
                                prefHeight="34.0"
                                prefWidth="140.0"
                                text="Back to Login"
                                textFill="WHITE" />
                    </children>
                </VBox>
            </left>

            <right>
                <VBox alignment="CENTER"
                      maxWidth="410.0"
                      prefHeight="400.0"
                      prefWidth="410.0"
                      spacing="10.0"
                      style="-fx-background-color: transparent;"
                      BorderPane.alignment="CENTER">

                    <padding>
                        <Insets bottom="20.0"
                                left="45.0"
                                right="30.0"
                                top="20.0" />
                    </padding>

                    <children>

                        <Label text="RESET PASSWORD"
                               textFill="#1E90FF">
                            <font>
                                <Font name="System Bold"
                                      size="26.0" />
                            </font>
                        </Label>

                        <Label text="Verify your account information"
                               textFill="#777777">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>

                        <Label fx:id="messageLabel"
                               alignment="CENTER"
                               maxWidth="280.0"
                               textAlignment="CENTER"
                               textFill="#DD0808"
                               wrapText="true">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>

                        <VBox maxWidth="280.0"
                              spacing="4.0">

                            <children>
                                <Label text="Username"
                                       textFill="#333333">
                                    <font>
                                        <Font name="System Bold"
                                              size="12.0" />
                                    </font>
                                </Label>

                                <TextField fx:id="usernameField"
                                           prefHeight="36.0"
                                           promptText="Enter your username"
                                           style="-fx-background-color: rgba(255,255,255,0.96);
                                                  -fx-background-radius: 10;
                                                  -fx-border-radius: 10;
                                                  -fx-border-color: #CFCFCF;
                                                  -fx-padding: 0 12 0 12;" />
                            </children>
                        </VBox>

                        <VBox maxWidth="280.0"
                              spacing="4.0">

                            <children>
                                <Label text="Date of Birth"
                                       textFill="#333333">
                                    <font>
                                        <Font name="System Bold"
                                              size="12.0" />
                                    </font>
                                </Label>

                                <TextField fx:id="dateOfBirthField"
                                           prefHeight="36.0"
                                           promptText="MM/DD/YYYY"
                                           style="-fx-background-color: rgba(255,255,255,0.96);
                                                  -fx-background-radius: 10;
                                                  -fx-border-radius: 10;
                                                  -fx-border-color: #CFCFCF;
                                                  -fx-padding: 0 12 0 12;" />
                            </children>
                        </VBox>

                        <Button fx:id="verifyButton"
                                maxWidth="280.0"
                                mnemonicParsing="false"
                                onAction="#verifyIdentity"
                                prefHeight="38.0"
                                text="Verify Identity"
                                textFill="WHITE">
                            <font>
                                <Font name="System Bold"
                                      size="14.0" />
                            </font>
                        </Button>

                        <VBox fx:id="resetPasswordSection"
                              alignment="CENTER"
                              maxWidth="280.0"
                              spacing="8.0">

                            <children>

                                <VBox maxWidth="280.0"
                                      spacing="4.0">

                                    <children>
                                        <Label text="New Password"
                                               textFill="#333333">
                                            <font>
                                                <Font name="System Bold"
                                                      size="12.0" />
                                            </font>
                                        </Label>

                                        <PasswordField fx:id="newPasswordField"
                                                       prefHeight="36.0"
                                                       promptText="At least 6 characters"
                                                       style="-fx-background-color: rgba(255,255,255,0.96);
                                                              -fx-background-radius: 10;
                                                              -fx-border-radius: 10;
                                                              -fx-border-color: #CFCFCF;
                                                              -fx-padding: 0 12 0 12;" />
                                    </children>
                                </VBox>

                                <VBox maxWidth="280.0"
                                      spacing="4.0">

                                    <children>
                                        <Label text="Confirm New Password"
                                               textFill="#333333">
                                            <font>
                                                <Font name="System Bold"
                                                      size="12.0" />
                                            </font>
                                        </Label>

                                        <PasswordField fx:id="confirmPasswordField"
                                                       prefHeight="36.0"
                                                       promptText="Enter password again"
                                                       style="-fx-background-color: rgba(255,255,255,0.96);
                                                              -fx-background-radius: 10;
                                                              -fx-border-radius: 10;
                                                              -fx-border-color: #CFCFCF;
                                                              -fx-padding: 0 12 0 12;" />
                                    </children>
                                </VBox>

                                <Button fx:id="resetPasswordButton"
                                        maxWidth="280.0"
                                        mnemonicParsing="false"
                                        onAction="#resetPassword"
                                        prefHeight="38.0"
                                        text="Reset Password"
                                        textFill="WHITE">
                                    <font>
                                        <Font name="System Bold"
                                              size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </right>

        </BorderPane>
    </children>
</StackPane>
